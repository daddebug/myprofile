{
  "name": "dilida-playful-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/verify-production-privacy.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "upload:unity": "node scripts/upload-unity-to-vercel-blob.mjs",
    "portfolio:start": "vite",
    "portfolio:check": "node scripts/portfolio-workflow.mjs check",
    "portfolio:publish": "node scripts/portfolio-workflow.mjs publish",
    "portfolio:launcher-preflight": "node scripts/portfolio-workflow.mjs launcher-preflight",
    "portfolio:launcher-publish": "node scripts/portfolio-workflow.mjs launcher-publish",
    "publish:daily": "node scripts/portfolio-workflow.mjs publish",
    "portfolio:import": "node scripts/import-production-bundle.mjs",
    "portfolio:preflight": "node scripts/publishing-preflight.mjs",
    "test:publishing": "node scripts/publishing-preflight.test.mjs",
    "portfolio:verify": "node scripts/portfolio-workflow.mjs verify"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.6.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "playwright-core": "1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2",
    "vite": "^7.3.6"
  }
}
